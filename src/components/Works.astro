---
import WorkList from "./WorkList.astro";
import { ProjectLinkList } from "./ProjectLink/ProjectLink";

const productDesignProjects = [
  {
    id: "1",
    title: "Watson Design System",
    description:
      "Docplanner's design language for SaaS products and digital experiences.",
    href: "https://github.com/rafalziolek",
  },
  {
    id: "2",
    title: "UI experiments",
    description: "Random experiments done in free time.",
    href: "https://github.com/rafalziolek",
  },
  {
    id: "3",
    title: "Runchise",
    description: "Integrated solutions for restaurants and franchises.",
    href: "https://github.com/rafalziolek",
  },
  {
    id: "4",
    title: "Poza Matą Studio",
    description: "Boutique yoga studio located in Poland",
    href: "https://github.com/rafalziolek",
  },
];

const otherProjects = [
  {
    id: "1",
    title: "Photography",
    description:
      "Apart from design work I photograph professionally and as a hobby.",
    href: "https://github.com/rafalziolek",
  },
  {
    id: "2",
    title: "(Not product) Design",
    description: "Anything, but the product design work",
    href: "https://github.com/rafalziolek",
  },
];
---

<div class="works">
  <WorkList title="Product Design">
    <ProjectLinkList
      groupId="product-design"
      client:load
      projects={productDesignProjects}
    />
  </WorkList>
  <hr class="works__hr" />
  <WorkList title="Other">
    <ProjectLinkList
      groupId="other"
      client:load
      projects={otherProjects}
    /></WorkList
  >
</div>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
  }

  .works__hr {
    border: none;
    border-bottom: 2px solid #f1f0f0;
    border-radius: 4px;
    margin-inline: var(--space-16);
  }
</style>
